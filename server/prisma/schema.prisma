generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// This defines the 'Booking' table in your database.
model Booking {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  date      String
  time      String
  guests    String
  table     String
  createdAt DateTime @default(now())
}